<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Retention runs inside the tenant's Odoo. models/dialer_retention.py says what goes. -->
    <record id="cron_dialer_retention" model="ir.cron">
        <field name="name">Dialler: remove old transcripts and call-health timelines</field>
        <field name="model_id" ref="model_ariane_dialer_call"/>
        <field name="state">code</field>
        <field name="code">model._cron_dialer_retention()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
