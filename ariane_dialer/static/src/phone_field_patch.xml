<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ariane_dialer.DialButton">
        <button t-if="arianeDialerEnabled" type="button" class="btn btn-sm btn-link o_ariane_dial_btn ms-3 p-0 d-inline-flex align-items-center"
                title="Call with the dialler" t-on-click="onArianeDial">
            <i class="fa fa-headphones"/><small class="fw-bold ms-1">Dialler</small>
        </button>
        <button t-if="arianeDialerEnabled and arianeDialerState.demoAllowed" type="button"
                class="btn btn-sm btn-link o_ariane_demo_btn ms-3 p-0 d-inline-flex align-items-center"
                title="An AI sales rep calls this number while the coach runs (test numbers only)" t-on-click="onArianeDemoDial">
            <i class="fa fa-android"/><small class="fw-bold ms-1">AI rep call</small>
        </button>
    </t>
    <!-- Odoo compiles the form variant as its own template, so both need the button (as the sms module does). -->
    <t t-inherit="web.PhoneField" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_phone_content')]" position="inside">
            <t t-call="ariane_dialer.DialButton"/>
        </xpath>
    </t>
    <t t-inherit="web.FormPhoneField" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_phone_content')]" position="inside">
            <t t-call="ariane_dialer.DialButton"/>
        </xpath>
    </t>
</templates>
