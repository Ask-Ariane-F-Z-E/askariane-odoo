<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dialer" model="ir.module.category">
        <field name="name">Dialler</field>
        <field name="sequence">60</field>
    </record>
    <record id="group_dialer_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_dialer"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="group_dialer_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_dialer"/>
        <field name="implied_ids" eval="[(4, ref('group_dialer_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <!-- May start the AI-rep demo call. Nobody has it by default; the dialler
         service still refuses it outside test mode and off the test numbers. -->
    <record id="group_dialer_demo" model="res.groups">
        <field name="name">AI rep demo calls</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('group_dialer_user'))]"/>
    </record>

    <record id="rule_dialer_call_own" model="ir.rule">
        <field name="name">Dialler: reps see their own calls</field>
        <field name="model_id" ref="model_ariane_dialer_call"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_dialer_user'))]"/>
    </record>
    <record id="rule_dialer_call_manager" model="ir.rule">
        <field name="name">Dialler: managers see all calls</field>
        <field name="model_id" ref="model_ariane_dialer_call"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_dialer_manager'))]"/>
    </record>
    <record id="rule_dialer_call_company" model="ir.rule">
        <field name="name">Dialler: calls stay in their company</field>
        <field name="model_id" ref="model_ariane_dialer_call"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_dialer_segment_own" model="ir.rule">
        <field name="name">Dialler: reps see lines of their own calls</field>
        <field name="model_id" ref="model_ariane_dialer_call_segment"/>
        <field name="domain_force">[('call_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_dialer_user'))]"/>
    </record>
    <record id="rule_dialer_segment_manager" model="ir.rule">
        <field name="name">Dialler: managers see all call lines</field>
        <field name="model_id" ref="model_ariane_dialer_call_segment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_dialer_manager'))]"/>
    </record>
    <record id="rule_dialer_segment_company" model="ir.rule">
        <field name="name">Dialler: call lines stay in their company</field>
        <field name="model_id" ref="model_ariane_dialer_call_segment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
